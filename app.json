{
  "expo": {
    "name": "NutriTrack",
    "slug": "nutritrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "NutriTrack",
      "shortName": "NutriTrack",
      "lang": "en",
      "description": "Track meals, nutrition, activity, and progress.",
      "themeColor": "#327654",
      "backgroundColor": "#F1F5EF"
    },
    "experiments": {
      "baseUrl": "/nutritrack"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "nutritrack"
  }
}
